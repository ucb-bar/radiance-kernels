    const uint32_t nwarps = threads_per_threadblock / NT;
    const _Float16 scale = as_bf16(softmax_scale_bf16);
    volatile __attribute__((address_space(1))) uint16_t *buf =
        reinterpret_cast<volatile __attribute__((address_space(1))) uint16_t *>(0x15000) + warp * NT;
    const uint32_t b_of_lane = lane / LPB;

