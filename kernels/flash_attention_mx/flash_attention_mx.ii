        l_state[row] = __builtin_bit_cast(uint16_t, (_Float16)(l_old * corr + rowsum));
        m_state[row] = __builtin_bit_cast(uint16_t, m_new);
        corr_out[row] = __builtin_bit_cast(uint16_t, corr);
