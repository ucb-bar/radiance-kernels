template <uint32_t SQ, uint32_t BK>
static __attribute__((noinline)) void fused_softmax_requant(
        const __attribute__((address_space(1))) uint16_t *S_smem16, __attribute__((address_space(1))) uint32_t *spad_u32,
        __attribute__((address_space(1))) uint32_t *scale_scratch,
        __attribute__((address_space(1))) uint16_t *m_state, __attribute__((address_space(1))) uint16_t *l_state, __attribute__((address_space(1))) uint16_t *corr_out,
        uint16_t softmax_scale_bf16, uint32_t first_block,
        uint32_t tid_in_threadblock, uint32_t threads_per_threadblock) {
    constexpr uint32_t NT = 16;
    constexpr uint32_t CPL = BK / NT;
