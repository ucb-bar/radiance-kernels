            l_state[row] = __builtin_bit_cast(uint16_t, (_Float16)(l_old * corr + rowsum));
            m_state[row] = __builtin_bit_cast(uint16_t, m_new);
            corr_out[row] = __builtin_bit_cast(uint16_t, corr);
        }

        _Float16 bPmax = mu_fexp((_Float16)(bSmax - m_new));
        int se = bf16_floor_log2(__builtin_bit_cast(uint16_t, bPmax));
        if ((lane % LPB) == 0) scale_scratch[b_of_lane * SQ + row] = (uint32_t)(uint8_t)(se + 127);

        const uint32_t ti = row / 16, rr = row % 16;
        for (uint32_t w = 0; w < CPL / 4; w++) {
            const uint32_t col0 = lane * CPL + w * 4;
            uint32_t packed = 0;
            for (uint32_t k = 0; k < 4; k++) {


                packed |= (uint32_t)bf16_to_e4m3_scaled(
                              __builtin_bit_cast(uint16_t, s[w * 4 + k]), se) << (8 * k);
            }
            const uint32_t tk = col0 / 16, cc = col0 % 16;
            spad_u32[((ti * PE_TILES_K + tk) * 256 + rr * 16 + cc) / 4] = packed;
        }
    }
}



template <uint32_t SQ, uint32_t D>
static __attribute__((noinline)) void rescale_accumulate(
        __attribute__((address_space(1))) uint32_t *O_acc32, const __attribute__((address_space(1))) uint32_t *PV32,
        const __attribute__((address_space(1))) uint16_t *corr_out, uint32_t first_block,
        uint32_t tid_in_threadblock, uint32_t threads_per_threadblock) {
    constexpr uint32_t NT = 16;
    constexpr uint32_t DW = D / 2;
    const uint32_t lane = tid_in_threadblock % NT;
    const uint32_t warp = tid_in_threadblock / NT;
    const uint32_t nwarps = threads_per_threadblock / NT;
    constexpr uint32_t NPL = DW / NT;
    for (uint32_t row = warp; row < SQ; row += nwarps) {
        const _Float16 c = as_bf16(corr_out[row]);


        uint32_t pv[NPL], oa[NPL];
#pragma unroll
        for (uint32_t k = 0; k < NPL; k++) pv[k] = PV32[row * DW + lane + k * NT];
        if (!first_block) {
#pragma unroll
            for (uint32_t k = 0; k < NPL; k++) oa[k] = O_acc32[row * DW + lane + k * NT];
        }
#pragma unroll
        for (uint32_t k = 0; k < NPL; k++) {
            _Float16 plo = as_bf16((uint16_t)pv[k]), phi = as_bf16((uint16_t)(pv[k] >> 16));
            _Float16 olo = (_Float16)0, ohi = (_Float16)0;
            if (!first_block) { olo = as_bf16((uint16_t)oa[k]); ohi = as_bf16((uint16_t)(oa[k] >> 16)); }
            O_acc32[row * DW + lane + k * NT] =
                pack_bf16x2((_Float16)(olo * c + plo), (_Float16)(ohi * c + phi));
        }
    }
}


template <uint32_t SQ, uint32_t D>
static __attribute__((noinline)) void finalize_O(
        const __attribute__((address_space(1))) uint32_t *O_acc32, const __attribute__((address_space(1))) uint16_t *l_state,
        uint32_t *O_gmem32, uint32_t tid_in_threadblock, uint32_t threads_per_threadblock) {
    constexpr uint32_t NT = 16;
    constexpr uint32_t DW = D / 2;
    const uint32_t lane = tid_in_threadblock % NT;
    const uint32_t warp = tid_in_threadblock / NT;
    const uint32_t nwarps = threads_per_threadblock / NT;
    constexpr uint32_t NPL = DW / NT;
    for (uint32_t row = warp; row < SQ; row += nwarps) {
        const _Float16 inv_l =
            (_Float16)(__builtin_bit_cast(_Float16, ((uint16_t)0x3f80)) / as_bf16(l_state[row]));
        uint32_t a[NPL];
#pragma unroll
        for (uint32_t k = 0; k < NPL; k++) a[k] = O_acc32[row * DW + lane + k * NT];
#pragma unroll
        for (uint32_t k = 0; k < NPL; k++)
            O_gmem32[row * DW + lane + k * NT] =
                pack_bf16x2((_Float16)(as_bf16((uint16_t)a[k]) * inv_l),
                            (_Float16)(as_bf16((uint16_t)(a[k] >> 16)) * inv_l));
    }
}




template <uint32_t SQ, uint32_t SK>
static __attribute__((noinline)) void copy_P_to_requant(const __attribute__((address_space(1))) uint32_t *P_smem32,
                                     __attribute__((address_space(1))) uint16_t *requant_smem,
                                     uint32_t tid_in_threadblock) {
    if (tid_in_threadblock >= 16) return;
    constexpr uint32_t NW = (SQ * SK) / 2;
    for (uint32_t i = tid_in_threadblock; i < NW; i += 16) {
        uint32_t w = P_smem32[i];
        requant_smem[2 * i] = (uint16_t)w;
        requant_smem[2 * i + 1] = (uint16_t)(w >> 16);
    }
}
# 545 "./flash_mx_impl.hpp"
template <uint32_t SQ, uint32_t SK>
static __attribute__((noinline)) void requant_P_to_spad_tiled(
        const __attribute__((address_space(1))) uint16_t *P_smem16, __attribute__((address_space(1))) uint32_t *spad_u32,
        __attribute__((address_space(1))) uint32_t *scale_scratch, uint32_t tid_in_threadblock,
        uint32_t threads_per_threadblock) {
    constexpr uint32_t NBLK = SK / 32;
    constexpr uint32_t PE_TILES_K = SK / 16;
    for (uint32_t row = tid_in_threadblock; row < SQ; row += threads_per_threadblock) {
        const __attribute__((address_space(1))) uint16_t *Prow = P_smem16 + row * SK;
        const uint32_t ti = row / 16, rr = row % 16;
        for (uint32_t b = 0; b < NBLK; b++) {

            _Float16 bmax = as_bf16((uint16_t)0);
            for (uint32_t c = 0; c < 32; c++) {
                _Float16 v = as_bf16(Prow[b * 32 + c]);
                _Float16 a = (v < (_Float16)0) ? (_Float16)(-v) : v;
                bmax = fmaxf(bmax, a);
            }
            int se = bf16_floor_log2(__builtin_bit_cast(uint16_t, bmax));
            scale_scratch[b * SQ + row] = (uint32_t)(uint8_t)(se + 127);

            for (uint32_t w = 0; w < 8; w++) {
                const uint32_t col0 = b * 32 + w * 4;
                uint32_t packed = 0;
                for (uint32_t k = 0; k < 4; k++) {
                    _Float16 ps = bf16_scale_pow2(as_bf16(Prow[col0 + k]), -se);

                    uint8_t e = bf16_to_e4m3< false>(__builtin_bit_cast(uint16_t, ps));
                    packed |= (uint32_t)e << (8 * k);
                }
                const uint32_t tk = col0 / 16, cc = col0 % 16;
                const uint32_t byte_off = (ti * PE_TILES_K + tk) * 256 + rr * 16 + cc;
                spad_u32[byte_off / 4] = packed;
            }
        }
    }
}





template <uint32_t SQ, uint32_t SK>
static __attribute__((noinline)) void pack_scales_to_sfmem(
        const __attribute__((address_space(1))) uint32_t *scale_scratch, __attribute__((address_space(1))) uint32_t *sfmem_a32,
        uint32_t tid_in_threadblock, uint32_t threads_per_threadblock) {


    if (tid_in_threadblock != 0) return;
    constexpr uint32_t NS = (SK / 32) * SQ;
    for (uint32_t w = 0; w < NS / 4; w++) {
        uint32_t packed = 0;
        for (uint32_t k = 0; k < 4; k++)
            packed |= (scale_scratch[w * 4 + k] & 0xff) << (8 * k);
        sfmem_a32[w] = packed;
    }
}





template <uint32_t SQ, uint32_t D>
static __attribute__((noinline)) void normalize_output(const __attribute__((address_space(1))) uint32_t *O_smem32, uint32_t *O_gmem32,
                                     const __attribute__((address_space(1))) uint16_t *l_smem,
                                     uint32_t tid_in_threadblock,
                                     uint32_t threads_per_threadblock) {
    constexpr uint32_t NT = 16;
    constexpr uint32_t WPL = D / (2 * NT);
    constexpr uint32_t DW = D / 2;
    const uint32_t lane = tid_in_threadblock % NT;
    const uint32_t warp = tid_in_threadblock / NT;
    const uint32_t nwarps = threads_per_threadblock / NT;

    for (uint32_t row = warp; row < SQ; row += nwarps) {
        _Float16 inv_l = (_Float16)((_Float16)__builtin_bit_cast(_Float16, ((uint16_t)0x3f80))
                                    / as_bf16(l_smem[row]));
        const __attribute__((address_space(1))) uint32_t *Orow = O_smem32 + row * DW;
        uint32_t *Out = O_gmem32 + row * DW;
        for (uint32_t j = 0; j < WPL; j++) {
            uint32_t w = Orow[j * NT + lane];
            _Float16 lo = (_Float16)(as_bf16((uint16_t)w) * inv_l);
            _Float16 hi = (_Float16)(as_bf16((uint16_t)(w >> 16)) * inv_l);
            Out[j * NT + lane] = pack_bf16x2(lo, hi);
        }
    }
}
